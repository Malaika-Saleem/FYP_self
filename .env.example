# DetectifAI Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# MONGODB CONFIGURATION (Required for Facial Recognition)
# =============================================================================

# MongoDB connection string for facial recognition metadata storage
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/detectifai?retryWrites=true&w=majority
# For local MongoDB:
# MONGO_URI=mongodb://localhost:27017/detectifai

# Example MongoDB Atlas connection (replace with your actual credentials):
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/detectifai?retryWrites=true&w=majority

# MongoDB database name
MONGO_DB_NAME=detectifai

# =============================================================================
# FACIAL RECOGNITION CONFIGURATION
# =============================================================================

# Enable/disable facial recognition processing
ENABLE_FACIAL_RECOGNITION=true

# Face detection confidence threshold (0.0 - 1.0)
FACE_DETECTION_CONFIDENCE=0.5

# Face similarity threshold for matching (0.0 - 1.0)
FACE_SIMILARITY_THRESHOLD=0.6

# Device to use for facial recognition (cpu or cuda)
FACE_DETECTION_DEVICE=cpu

# =============================================================================
# MINIO CONFIGURATION (for video/image storage)
# =============================================================================

# MinIO server configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Default bucket for video processing
MINIO_BUCKET=detectifai-videos

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=true

# Upload and processing directories
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=video_processing_outputs
MODELS_FOLDER=models

# GPU acceleration
USE_GPU_ACCELERATION=false

# =============================================================================
# SECURITY CONFIGURATION  
# =============================================================================

# JWT secret key for authentication (change this in production!)
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# API rate limiting
API_RATE_LIMIT=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/detectifai.log

# Enable detailed processing logs
ENABLE_PROCESSING_LOGS=true