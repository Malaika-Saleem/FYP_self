# --------------------------
# Configuration dataclasses
# --------------------------
@dataclass
class EmbedConfig:
    device: str = "cuda" if torch.cuda.is_available() else "cpu"
    clip_model_name: str = "openai/clip-vit-base-patch32"  # solid default
    xclip_model_name: str = "microsoft/xclip-base-patch16"  # optional
    yolo_model_name: str = "yolov8n.pt"  # small + fast
    frame_sample_rate: int = 6           # take 1 frame every N frames
    max_frames_per_clip: int = 32        # cap for speed
    kmeans_colors: int = 3               # for attribute (dominant colors)
    min_box_area: int = 25 * 25          # ignore tiny boxes
    conf_thresh: float = 0.25            # YOLO confidence threshold
    iou_thresh: float = 0.5

# Basic action/event vocabulary (extend as you like)
DEFAULT_ACTION_LABELS = [
    # Generic motion
    "walking", "running", "standing", "sitting", "falling",
    # Store-like events
    "entering", "leaving", "queuing", "paying at the counter", "loitering",
    # Interactions / gestures
    "waving", "fighting", "pushing", "carrying a bag", "holding a phone",
    # Vehicles
    "car stopping", "car starting", "car parking", "bike riding",
]

# Basic objects to highlight (YOLO already gives labels; this list is for filtering/standardizing)
OBJECT_WHITELIST = {
    "person", "car", "bicycle", "motorcycle", "bus", "truck",
    "backpack", "handbag", "suitcase", "cell phone", "umbrella",
    "dog", "cat", "chair", "bench", "bottle"
}

# Map raw RGB to coarse color words
COLOR_NAME_PALETTE = {
    "red":     np.array([200,  30,  30]),
    "green":   np.array([ 30, 180,  60]),
    "blue":    np.array([ 40,  80, 200]),
    "yellow":  np.array([220, 220,  40]),
    "purple":  np.array([150,  60, 180]),
    "orange":  np.array([240, 150,  40]),
    "black":   np.array([ 10,  10,  10]),
    "white":   np.array([240, 240, 240]),
    "gray":    np.array([128, 128, 128]),
    "brown":   np.array([120,  80,  40]),
}

def _closest_color_name(rgb: np.ndarray) -> str:
    # rgb is [R,G,B]
    best_name, best_d = None, 1e9
    for name, ref in COLOR_NAME_PALETTE.items():
        d = np.linalg.norm(rgb.astype(np.float32) - ref.astype(np.float32))
        if d < best_d:
            best_d, best_name = d, name
    return best_name or "unknown"

# --------------------------
# Helpers
# --------------------------
def bgr_to_pil(frame_bgr: np.ndarray) -> Image.Image:
    return Image.fromarray(cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB))

def sample_frames_from_clip(clip_path: str, cfg: EmbedConfig) -> List[Image.Image]:
    """Sample frames uniformly from a short clip using OpenCV."""
    cap = cv2.VideoCapture(clip_path)
    if not cap.isOpened():
        raise RuntimeError(f"Could not open video: {clip_path}")

    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 0
    sample_every = max(1, cfg.frame_sample_rate)
    frames = []
    idx = 0
    while True:
        ret, frame = cap.read()
        if not ret:
            break
        if idx % sample_every == 0:
            frames.append(bgr_to_pil(frame))
        idx += 1
        if len(frames) >= cfg.max_frames_per_clip:
            break
    cap.release()
    return frames

def average_pool_embeddings(embs: List[torch.Tensor]) -> torch.Tensor:
    """L2-normalized average-pooled embedding."""
    if not embs:
        return torch.zeros(1)
    X = torch.stack(embs, dim=0)  # [T, D]
    X = F.normalize(X, dim=-1)
    pooled = X.mean(dim=0)
    return F.normalize(pooled, dim=-1)

# --------------------------
# Models
# --------------------------
class CLIPEncoder:
    def __init__(self, model_name: str, device: str):
        self.device = device
        self.model = CLIPModel.from_pretrained(model_name).to(device)
        self.processor = CLIPProcessor.from_pretrained(model_name)

    @torch.no_grad()
    def encode_images(self, pil_images: List[Image.Image]) -> List[torch.Tensor]:
        embs = []
        if not pil_images:
            return embs
        batch = self.processor(images=pil_images, return_tensors="pt")
        batch = {k: v.to(self.device) for k, v in batch.items()}
        out = self.model.get_image_features(**batch)  # [B, D]
        out = F.normalize(out, dim=-1)
        for i in range(out.size(0)):
            embs.append(out[i].detach().cpu())
        return embs

    @torch.no_grad()
    def encode_text(self, texts: List[str]) -> torch.Tensor:
        batch = self.processor(text=texts, return_tensors="pt", padding=True)
        batch = {k: v.to(self.device) for k, v in batch.items()}
        out = self.model.get_text_features(**batch)  # [B, D]
        return F.normalize(out, dim=-1).detach().cpu()

class XCLIPEncoder:
    def __init__(self, model_name: str, device: str):
        if not _HAS_XCLIP:
            raise RuntimeError("X-CLIP not available in this environment.")
        self.device = device
        self.model = XCLIPModel.from_pretrained(model_name).to(device)
        self.processor = XCLIPProcessor.from_pretrained(model_name)

    @torch.no_grad()
    def encode_video(self, pil_frames: List[Image.Image]) -> torch.Tensor:
        if not pil_frames:
            return torch.zeros(1)
        inputs = self.processor(videos=pil_frames, return_tensors="pt")
        inputs = {k: v.to(self.device) for k, v in inputs.items()}
        outputs = self.model.get_video_features(**inputs)  # [1, D]
        return F.normalize(outputs[0], dim=-1).detach().cpu()

# --------------------------
# Detection & Attributes
# --------------------------
class ObjectDetector:
    def __init__(self, model_name: str, device: str, conf: float, iou: float):
        self.model = YOLO(model_name)
        self.model.to(device)
        self.conf = conf
        self.iou = iou

    def detect(self, frame_bgr: np.ndarray) -> List[Dict[str, Any]]:
        res = self.model.predict(
            source=frame_bgr, verbose=False, conf=self.conf, iou=self.iou
        )[0]
        dets = []
        if res.boxes is None:
            return dets
        for b in res.boxes:
            cls_id = int(b.cls.item())
            conf = float(b.conf.item())
            xyxy = b.xyxy[0].cpu().numpy().astype(int)
            name = res.names.get(cls_id, str(cls_id))
            x1, y1, x2, y2 = [int(v) for v in xyxy]
            w, h = x2 - x1, y2 - y1
            if w * h < 1:
                continue
            dets.append({
                "label": name,
                "conf": conf,
                "bbox": [x1, y1, x2, y2],
                "area": w * h,
            })
        return dets

def box_crop_rgb(frame_bgr: np.ndarray, box: List[int]) -> np.ndarray:
    x1, y1, x2, y2 = box
    x1, y1 = max(0, x1), max(0, y1)
    x2, y2 = min(frame_bgr.shape[1], x2), min(frame_bgr.shape[0], y2)
    crop_bgr = frame_bgr[y1:y2, x1:x2]
    if crop_bgr.size == 0:
        return np.zeros((1, 1, 3), dtype=np.uint8)
    return cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2RGB)

def dominant_colors_rgb(img_rgb: np.ndarray, K: int) -> List[np.ndarray]:
    H, W, C = img_rgb.shape
    if H * W < 50:
        return []
    X = img_rgb.reshape(-1, 3).astype(np.float32)
    km = KMeans(n_clusters=min(K, len(X)), n_init=5, random_state=0)
    km.fit(X)
    centers = km.cluster_centers_  # [K,3]
    return [c for c in centers]

def infer_color_attributes(frame_bgr: np.ndarray, dets: List[Dict[str, Any]]) -> List[str]:
    attrs = []
    for d in dets:
        if d["area"] < 25 * 25:
            continue
        # focus on persons/vehicles/bags for attributes
        if d["label"] not in {"person", "car", "truck", "bus", "bicycle", "motorcycle", "backpack", "handbag", "suitcase"}:
            continue
        crop = box_crop_rgb(frame_bgr, d["bbox"])
        centers = dominant_colors_rgb(crop, K=2)
        for c in centers:
            color_name = _closest_color_name(c)
            # build attribute phrase
            if d["label"] == "person":
                attrs.append(f"{color_name} clothing")
            elif d["label"] in {"backpack", "handbag", "suitcase"}:
                attrs.append(f"{color_name} bag")
            else:
                attrs.append(f"{color_name} {d['label']}")
    # dedupe
    return sorted(set(attrs))

# --------------------------
# Zero-shot actions/events with CLIP
# --------------------------
def zero_shot_actions_clip(
    clip_encoder: CLIPEncoder,
    frame_images: List[Image.Image],
    candidate_labels: List[str],
    topk: int = 5
) -> List[str]:
    if not frame_images:
        return []
    img_embs = clip_encoder.encode_images(frame_images)   # [T, D]
    clip_emb = average_pool_embeddings(img_embs)          # [D]
    text_embs = clip_encoder.encode_text(candidate_labels)  # [L, D]
    # cosine similarity
    sims = (clip_emb.unsqueeze(0) @ text_embs.T).squeeze(0).numpy()  # [L]
    order = np.argsort(-sims)
    picked = []
    for idx in order[:topk]:
        picked.append(candidate_labels[int(idx)])
    return picked

# --------------------------
# Main per-clip processor
# --------------------------
@dataclass
class ClipUnderstandingOutput:
    clip_path: str
    clip_embedding_clip: Optional[List[float]]
    clip_embedding_xclip: Optional[List[float]]
    objects: List[str]
    attributes: List[str]
    actions: List[str]
    debug: Dict[str, Any]

class ClipUnderstander:
    def __init__(self, cfg: EmbedConfig = EmbedConfig()):
        self.cfg = cfg
        self.clip_enc = CLIPEncoder(cfg.clip_model_name, cfg.device)
        self.detector = ObjectDetector(cfg.yolo_model_name, cfg.device, cfg.conf_thresh, cfg.iou_thresh)
        self.xclip_enc = None
        if _HAS_XCLIP:
            try:
                self.xclip_enc = XCLIPEncoder(cfg.xclip_model_name, cfg.device)
            except Exception:
                self.xclip_enc = None

    def _frame_bgr_from_pil(self, img: Image.Image) -> np.ndarray:
        return cv2.cvtColor(np.array(img), cv2.COLOR_RGB2BGR)

    @torch.no_grad()
    def process_clip(self, clip_path: str,
                     action_labels: Optional[List[str]] = None) -> ClipUnderstandingOutput:
        os.makedirs(os.path.dirname(clip_path) or ".", exist_ok=True)
        frames_pil = sample_frames_from_clip(clip_path, self.cfg)

        # --- Embeddings (CLIP image pooled) ---
        img_embs = self.clip_enc.encode_images(frames_pil)
        pooled_clip = average_pool_embeddings(img_embs)
        clip_vec = pooled_clip.numpy().tolist() if pooled_clip.ndim == 1 else None

        # --- Embeddings (X-CLIP video) optional ---
        xclip_vec = None
        if self.xclip_enc is not None:
            try:
                vid_feat = self.xclip_enc.encode_video(frames_pil)
                xclip_vec = vid_feat.numpy().tolist() if vid_feat.ndim == 1 else None
            except Exception:
                xclip_vec = None

        # --- Objects + Attributes via YOLO ---
        objects_collected = []
        attributes_collected = []
        for img in frames_pil[: min(8, len(frames_pil))]:  # a few frames suffice
            frame_bgr = self._frame_bgr_from_pil(img)
            dets = self.detector.detect(frame_bgr)
            objs = [d["label"] for d in dets if d["label"] in OBJECT_WHITELIST and d["area"] >= self.cfg.min_box_area]
            objects_collected.extend(objs)
            attributes_collected.extend(infer_color_attributes(frame_bgr, dets))
        objects_collected = sorted(set(objects_collected))
        attributes_collected = sorted(set(attributes_collected))

        # --- Zero-shot actions/events via CLIP similarity ---
        labels = action_labels or DEFAULT_ACTION_LABELS
        actions_pred = zero_shot_actions_clip(self.clip_enc, frames_pil, labels, topk=min(5, len(labels)))

        debug = {
            "num_sampled_frames": len(frames_pil),
            "used_xclip": self.xclip_enc is not None,
            "clip_model": self.cfg.clip_model_name,
            "xclip_model": self.cfg.xclip_model_name if self.xclip_enc is not None else None,
            "yolo_model": self.cfg.yolo_model_name,
        }

        return ClipUnderstandingOutput(
            clip_path=clip_path,
            clip_embedding_clip=clip_vec,
            clip_embedding_xclip=xclip_vec,
            objects=objects_collected,
            attributes=attributes_collected,
            actions=actions_pred,
            debug=debug,
        )

# --------------------------
# CLI / Example usage
# --------------------------
def process_folder(folder: str, out_json: str, cfg: EmbedConfig = EmbedConfig()):
    cu = ClipUnderstander(cfg)
    results = []
    video_exts = {".mp4", ".avi", ".mov", ".mkv", ".m4v"}
    files = [os.path.join(folder, f) for f in os.listdir(folder) if os.path.splitext(f)[1].lower() in video_exts]
    for f in tqdm(files, desc="Processing clips"):
        try:
            out = cu.process_clip(f)
            results.append(asdict(out))
        except Exception as e:
            print(f"[WARN] Failed on {f}: {e}")
    with open(out_json, "w", encoding="utf-8") as fp:
        json.dump(results, fp, indent=2)
    print(f"Saved {len(results)} clip descriptors to {out_json}")

